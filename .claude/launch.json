{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "app-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd public && set DB_DATABASE=social_manager_demo&& php -S localhost:8001 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"
      ],
      "port": 8001,
      "url": "http://localhost:8001"
    }
  ]
}
